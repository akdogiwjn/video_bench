# 视频 Agent benchmark configuration
# 只需填两个 key，下面四行中 LLM_API_KEY / VLM_API_KEY 保持 ${...} 不用动。
# 复制到 config.env 后把两个 replace 改成真实 key 即可。

# === Key 1: DeepSeek ===
DEEPSEEK_API_KEY=replace-with-your-key
LLM_API_KEY=${DEEPSEEK_API_KEY}

# === Key 2: DashScope (阿里云百炼) ===
# 获取：https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=replace-with-your-key
VLM_API_KEY=${DASHSCOPE_API_KEY}

# 以下不用改
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
VLM_MODEL=qwen-vl-max
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_PROVIDER=minimax
TTS_API_KEY=
IMAGE_GEN=video-bench-gen:1.0
IMAGE_EDIT=video-bench-edit:1.0
CPUS=2
MEMORY=4g
CPUSET=0,1
KEEP_CONTAINER=0
